{
  "name": "dsh-qq-tools",
  "version": "0.9.1",
  "description": "给大肥鱼会话用的 QQ 群/私聊工具：列群、看群记录、发群消息（可引用/@）、发表情、收藏表情（SnowLuma 收藏夹）、好友/私聊记录、发私聊消息、私聊唤醒、群成员、戳一戳感知/戳回去、更改头像、好友管理（资料/备注/分组/删好友/名片赞/好友申请）、QQ 空间说说（列表/详情/发表/评论/点赞/权限）、挂载会话选择。11 个工具组加 1 个设置组件，可在插件页逐个开关。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "cyhddyx",
  "homepage": "https://github.com/cyhddyx/dsh-qq-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyhddyx/dsh-qq-tools.git"
  },
  "bugs": {
    "url": "https://github.com/cyhddyx/dsh-qq-tools/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qq",
    "onebot",
    "snowluma",
    "napcat"
  ],
  "files": [
    "lib",
    "tools",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "docs/verification",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./tools/qq-list-groups": "./tools/qq-list-groups/index.js",
    "./tools/qq-list-groups/locale/en.json": "./tools/qq-list-groups/locale/en.json",
    "./tools/qq-list-groups/locale/zh.json": "./tools/qq-list-groups/locale/zh.json",
    "./tools/qq-get-group-history": "./tools/qq-get-group-history/index.js",
    "./tools/qq-get-group-history/locale/en.json": "./tools/qq-get-group-history/locale/en.json",
    "./tools/qq-get-group-history/locale/zh.json": "./tools/qq-get-group-history/locale/zh.json",
    "./tools/qq-get-group-members": "./tools/qq-get-group-members/index.js",
    "./tools/qq-get-group-members/locale/en.json": "./tools/qq-get-group-members/locale/en.json",
    "./tools/qq-get-group-members/locale/zh.json": "./tools/qq-get-group-members/locale/zh.json",
    "./tools/qq-send-group-message": "./tools/qq-send-group-message/index.js",
    "./tools/qq-send-group-message/locale/en.json": "./tools/qq-send-group-message/locale/en.json",
    "./tools/qq-send-group-message/locale/zh.json": "./tools/qq-send-group-message/locale/zh.json",
    "./tools/qq-send-face": "./tools/qq-send-face/index.js",
    "./tools/qq-send-face/locale/en.json": "./tools/qq-send-face/locale/en.json",
    "./tools/qq-send-face/locale/zh.json": "./tools/qq-send-face/locale/zh.json",
    "./tools/qq-favorite-faces": "./tools/qq-favorite-faces/index.js",
    "./tools/qq-favorite-faces/locale/en.json": "./tools/qq-favorite-faces/locale/en.json",
    "./tools/qq-favorite-faces/locale/zh.json": "./tools/qq-favorite-faces/locale/zh.json",
    "./tools/qq-private-chat": "./tools/qq-private-chat/index.js",
    "./tools/qq-private-chat/locale/en.json": "./tools/qq-private-chat/locale/en.json",
    "./tools/qq-private-chat/locale/zh.json": "./tools/qq-private-chat/locale/zh.json",
    "./tools/qq-send-poke": "./tools/qq-send-poke/index.js",
    "./tools/qq-send-poke/locale/en.json": "./tools/qq-send-poke/locale/en.json",
    "./tools/qq-send-poke/locale/zh.json": "./tools/qq-send-poke/locale/zh.json",
    "./tools/qq-set-avatar": "./tools/qq-set-avatar/index.js",
    "./tools/qq-set-avatar/locale/en.json": "./tools/qq-set-avatar/locale/en.json",
    "./tools/qq-set-avatar/locale/zh.json": "./tools/qq-set-avatar/locale/zh.json",
    "./tools/qq-friend-management": "./tools/qq-friend-management/index.js",
    "./tools/qq-friend-management/locale/en.json": "./tools/qq-friend-management/locale/en.json",
    "./tools/qq-friend-management/locale/zh.json": "./tools/qq-friend-management/locale/zh.json",
    "./tools/qq-qzone": "./tools/qq-qzone/index.js",
    "./tools/qq-qzone/locale/en.json": "./tools/qq-qzone/locale/en.json",
    "./tools/qq-qzone/locale/zh.json": "./tools/qq-qzone/locale/zh.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "compatibility": {
      "dsh": "0.2.x",
      "node": ">=22"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  }
}
